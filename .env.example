# توکن ربات که از @BotFather می‌گیرید
BOT_TOKEN=123456789:AAExampleTokenHere

# آیدی عددی ادمین‌ها با کاما جدا کنید (برای دسترسی به /addhadith)
# آیدی عددی خودتان را از @userinfobot بگیرید
ADMIN_IDS=123456789

# مسیر فایل دیتابیس (نیازی به تغییر نیست)
DATABASE_PATH=bot_database.db

# فقط در صورتی که روی هاست/سرور ایرانی هستید و به تلگرام دسترسی مستقیم ندارید
# این را پر کنید. در غیر این صورت خالی بگذارید.
# مثال SOCKS5:  socks5://127.0.0.1:1080
# مثال HTTP:    http://127.0.0.1:8080
PROXY_URL=
